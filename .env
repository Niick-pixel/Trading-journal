# Committed on purpose — this holds no secrets, only a guarantee.
#
# Next.js collects anonymous usage telemetry by default. Signature is meant to
# never talk to a server you don't control, so this turns it off for every
# `next` command in this project, on every machine that clones it.
#
# Machine-specific overrides belong in .env.local, which is gitignored.
NEXT_TELEMETRY_DISABLED=1
